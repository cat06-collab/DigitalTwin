{
  "name": "digital-twin-phone-controller",
  "version": "1.0.0",
  "description": "Digital Twin 3D controllato in tempo reale dai sensori dello smartphone (giroscopio e accelerometro) tramite WebSockets e Three.js.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "keywords": [
    "digital-twin",
    "threejs",
    "websockets",
    "deviceorientation",
    "devicemotion",
    "mobile-controller",
    "gyroscope"
  ],
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "qrcode": "^1.5.3"
  },
  "appConfig": {
    "serverPort": 3000,
    "websocketPath": "/ws",
    "shakeThreshold": 25.0,
    "explosionDurationMs": 3500,
    "smoothingFactor": 0.15,
    "vehicleAsset": {
      "modelType": "cyber-twin-car",
      "previewImage": "digital-twin-preview.png",
      "primaryColor": "#00f3ff",
      "secondaryColor": "#ff0055"
    }
  }
}
